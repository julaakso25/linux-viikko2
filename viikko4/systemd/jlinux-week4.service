[Unit]
Description=JLinux week 4 read-only counter
After=mariadb.service network.target
Wants=mariadb.service

[Service]
User=jlweek4
WorkingDirectory=/opt/jlinux-week4
ExecStart=/usr/bin/python3 -m gunicorn --bind 127.0.0.1:8764 --workers 2 app:application
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
